generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth (NextAuth email magic-link) ----------
// Note: this model is literally named "User" because @auth/prisma-adapter
// expects a model of that name. Everywhere else in the app we call this
// concept a "Player".

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- App domain ----------

enum Team {
  A
  B
}

enum MatchStatus {
  PENDING_SPREAD // DRAFT: only the admin can see/edit/delete it; not yet published for betting
  OPEN // published: spread locked in, betting open
  LOCKED // betting closed, waiting on result
  COMPLETED // result entered, bets settled
}

// A match logged purely for the ratings engine never goes through betting
// (no spread, no bets). A future week's lineup entered ahead of time with
// no score yet just stays PENDING_SPREAD (the existing draft state) with
// ratingOnly set once a result comes in and it was never published for
// betting.

enum BetOutcome {
  PENDING
  WIN
  LOSS
  PUSH
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String // real name or nickname, player's choice
  isAdmin       Boolean   @default(false)
  balance       Int       @default(1000)
  createdAt     DateTime  @default(now())
  emailVerified DateTime?

  // Tennis ratings (all optional; set by the admin's roster import).
  // individualRating is the USTA/NTRP rating and is shown next to the
  // player's name for everyone. The rest are admin-only and never sent to
  // other users: doublesRating is Eric's projection, teamNumber/teamRank
  // are the spreadsheet's team # and proposed 1-30 ranking.
  individualRating Float?
  doublesRating    Float?
  teamNumber       Int?
  teamRank         Int?

  // Ratings-engine bookkeeping. doublesRating (above) is now the LIVE,
  // match-driven number -- it starts at the admin's spreadsheet projection
  // and moves after every logged match (see lib/ratings.ts). This counter
  // is how a new or lightly-played player keeps moving faster than someone
  // with a long track record: see ratingKFactor() in lib/ratings.ts.
  ratingMatchesPlayed Int @default(0)

  accounts        Account[]
  sessions        Session[]
  matchEntries    MatchPlayer[]
  bets            Bet[]
  matchesLogged   Match[]                 @relation("MatchCreatedBy")
  ratingAdjustments MatchRatingAdjustment[]
}

// join table: which players are on which team for a given match
model MatchPlayer {
  id       String  @id @default(cuid())
  matchId  String
  playerId String
  team     Team

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player User  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
}

model Match {
  id          String      @id @default(cuid())
  status      MatchStatus @default(PENDING_SPREAD)
  scheduledAt DateTime?
  createdById String
  createdBy   User        @relation("MatchCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())

  // The spread is always expressed relative to Team A.
  // e.g. lineForTeamA = -5 means Team A is favored by 5 games.
  // lineForTeamA = +3 means Team A is getting 3 games.
  lineForTeamA Float?

  // Result, entered once the match is played
  sets   Set[]
  margin Float? // final game-differential margin for Team A, after tiebreak rules applied

  // True for a match logged for ratings only -- never went through betting
  // (no spread, no bets, possibly no scheduledAt beyond "this week"). Lets
  // the UI and queries tell a rating-only entry apart from a real betting
  // match without having to infer it from a null line.
  ratingOnly Boolean @default(false)

  players           MatchPlayer[]
  bets              Bet[]
  ratingAdjustments MatchRatingAdjustment[]
}

// One row per player per rated match, recording the exact rating delta
// applied. Mirrors how bets are re-settled: to edit or undo a result,
// reverse every row for that match (subtract delta back off doublesRating,
// decrement ratingMatchesPlayed, delete the rows) before recomputing --
// so re-entering a score is always safe no matter how many times it happens.
model MatchRatingAdjustment {
  id        String   @id @default(cuid())
  matchId   String
  playerId  String
  delta     Float // signed change applied to this player's doublesRating
  createdAt DateTime @default(now())

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player User  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
}

model Set {
  id              String  @id @default(cuid())
  matchId         String
  order           Int // 1, 2, 3
  teamAGames      Int
  teamBGames      Int
  isTiebreak      Boolean @default(false) // set decided by a standard tiebreak (e.g. 7-6)
  isMatchTiebreak Boolean @default(false) // 3rd-set match tiebreak (e.g. first to 10)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, order])
}

model Bet {
  id         String     @id @default(cuid())
  matchId    String
  playerId   String
  teamPicked Team
  amount     Int
  outcome    BetOutcome @default(PENDING)
  payout     Int? // net change to balance once settled (can be negative)
  createdAt  DateTime   @default(now())

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player User  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId]) // one bet per player per match
}

// Small key/value store for admin-tunable numbers (e.g. the ratings-to-line
// curve used to suggest a spread).
model Setting {
  key   String @id
  value Float
}
